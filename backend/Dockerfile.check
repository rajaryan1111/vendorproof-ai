FROM ghcr.io/astral-sh/uv:0.12.8 AS uv
FROM python:3.12-slim-bookworm
COPY --from=uv /uv /usr/local/bin/uv
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap tesseract-ocr-eng tesseract-ocr && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/vendorproof
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project --no-cache --python /usr/local/bin/python
COPY app ./app
USER 65534:65534
CMD ["sh", "-c", "exec .venv/bin/uvicorn app.platform_check:app --host 0.0.0.0 --port \"${PORT:-10000}\" --no-access-log --no-proxy-headers --limit-concurrency 16"]
